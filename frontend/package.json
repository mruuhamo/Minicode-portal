{
  "name": "@minicode/learning-section",
  "version": "0.1.0",
  "private": true,
  "description": "Minicode Learning section: searchable library of internal minicode recordings (standalone app + embeddable React component).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/lib/learning-section.js",
  "module": "./dist/lib/learning-section.js",
  "types": "./dist/lib/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/lib.d.ts",
      "import": "./dist/lib/learning-section.js"
    },
    "./style.css": "./dist/lib/learning-section.css"
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:lib",
    "build:app": "tsc -b && vite build",
    "build:lib": "vite build --mode lib && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "peerDependencies": {
    "@azure/msal-browser": "^5.0.0",
    "@azure/msal-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": ">=7.0.0"
  },
  "devDependencies": {
    "@azure/msal-browser": "^5.30.0",
    "@azure/msal-react": "^5.8.3",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
